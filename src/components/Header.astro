---
import Brand from './Brand.astro';
import Icon from './Icon.astro';

interface Props {
  page: string;
}

const { page } = Astro.props;
---

<header class="site-header glass">
  <div><Brand /></div>

  <nav class="desktop-nav" aria-label="Main navigation">
    <a href="/" aria-current={page === 'home' ? 'page' : undefined}>Home</a>
    <a href="/about.html" aria-current={page === 'about' ? 'page' : undefined}>About us</a>
    <a href="/gallery.html" aria-current={page === 'gallery' ? 'page' : undefined}>Gallery</a>
    <a href="https://discord.gg/nihilium" target="_blank" rel="noopener noreferrer">Discord <Icon name="external" /></a>
  </nav>

  <a class="nav-play" href="/#join">Play now <Icon name="arrow" /></a>

  <button class="menu-button" aria-label="Open navigation" aria-expanded="false" aria-controls="mobile-nav">
    <span></span><span></span>
  </button>

  <nav id="mobile-nav" class="mobile-nav" aria-label="Mobile navigation" hidden>
    <a href="/">Home</a>
    <a href="/about.html">About us</a>
    <a href="/gallery.html">Gallery</a>
    <a href="https://discord.gg/nihilium" target="_blank" rel="noopener noreferrer">Discord <Icon name="external" /></a>
    <a href="/#join">Join the server</a>
  </nav>
</header>
