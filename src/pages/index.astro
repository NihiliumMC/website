---
import GalleryCard from '../components/GalleryCard.astro';
import Icon from '../components/Icon.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { categoryName, gallery, homePhotos } from '../lib/gallery';
---

<BaseLayout
  title="Nihilium Anarchy — A world without limits"
  description="An open, cracked Minecraft anarchy world, shaped by its players. Join Nihilium on Java or Eaglercraft, check live player status, and make your mark."
  page="home"
  showGallery
>
  <main>
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-landscape" role="img" aria-label="Nihilium Minecraft spawn, with towering lava falls and player-built paths"></div>
      <div class="hero-shade"></div>
      <div class="hero-content page-width">
        <div class="hero-copy">
          <h1 id="hero-title">A world<br>without <span>limits.</span></h1>
          <p class="hero-description">A cracked Minecraft anarchy server for Java and Eaglercraft.</p>
          <div class="hero-actions">
            <button class="button button-light" data-copy="nihilium.org">Copy server IP <Icon name="copy" /></button>
            <a class="button button-glass" href="https://discord.gg/nihilium" target="_blank" rel="noopener noreferrer"><Icon name="discord" /> Join our Discord <Icon name="external" /></a>
          </div>
        </div>

        <aside class="live-card glass" aria-label="Live server status">
          <div class="live-top">
            <span class="status-badge" data-status-badge><i class="status-dot" data-status-dot></i><span data-status-label>CHECKING STATUS</span></span>
            <button class="refresh-button" data-refresh aria-label="Refresh server status" title="Refresh server status"><Icon name="refresh" /></button>
          </div>
          <div class="live-count" aria-live="polite"><span data-player-count>—</span><span class="signal" aria-hidden="true"><i></i><i></i><i></i><i></i></span></div>
          <p data-count-label>Players online</p>
          <div class="live-bottom"><span data-status-time>Connecting to Nihilium…</span></div>
          <details class="status-details">
            <summary>About this count</summary>
            <p>Server status is checked every minute. The status provider may cache results for up to five minutes. <Icon name="external" /> <a href="https://mcsrvstat.us/server/nihilium.org" target="_blank" rel="noopener noreferrer">View status source</a></p>
          </details>
        </aside>
      </div>
    </section>

    <section class="connection-section page-width" id="join" aria-labelledby="join-heading">
      <div class="connection-bar glass">
        <div class="connection-heading"><h2 id="join-heading">Join Nihilium</h2></div>
        <div class="connection-option">
          <div class="edition-label"><Icon name="monitor" /> Java Edition <span class="edition-tag" data-java-version>PC · MAC · LINUX</span></div>
          <button class="address-button" data-copy="nihilium.org" aria-label="Copy Java address nihilium.org"><span>nihilium.org</span><Icon name="copy" /></button>
          <span class="edition-help">Cracked supported · Multiplayer → Add Server</span>
        </div>
        <div class="connection-option eaglercraft-option">
          <div class="edition-label"><Icon name="cube" /> Eaglercraft <span class="edition-tag">BROWSER</span></div>
          <button class="address-button" data-copy="wss://play.nihilium.org" aria-label="Copy Eaglercraft address wss://play.nihilium.org"><span>wss://play.nihilium.org</span><Icon name="copy" /></button>
          <span class="edition-help">Add server in your Eaglercraft client</span>
        </div>
        <div class="connection-option bedrock-option">
          <div class="edition-label"><Icon name="controller" /> Bedrock Edition <span class="edition-tag">UNAVAILABLE</span></div>
          <button class="address-button" data-copy="bedrock.nihilium.org" aria-label="Bedrock is temporarily unavailable" disabled><span>bedrock.nihilium.org</span></button>
          <div class="edition-help is-unavailable-help">Temporarily offline<span>·</span><a href="https://discord.gg/nihilium" target="_blank" rel="noopener noreferrer">Join Discord for updates <Icon name="external" /></a></div>
        </div>
      </div>
    </section>

    <section class="world-section page-width" aria-labelledby="world-heading">
      <div class="section-heading"><div><h2 id="world-heading">About the server</h2></div></div>
      <div class="feature-grid">
        <article class="feature-card glass">
          <div class="feature-icon"><Icon name="compass" /></div>
          <h3>Anarchy survival</h3>
          <p>Build, explore, form alliances, or play solo.</p>
        </article>
        <article class="feature-card glass">
          <div class="feature-icon"><Icon name="history" /></div>
          <h3>Since January 2025</h3>
          <p>Running since January 2025, with around 800 GB of discoveries, creations, and player history.</p>
          <a class="card-bottom" href="/about.html">About Nihilium <Icon name="arrow" /></a>
        </article>
        <article class="feature-card glass">
          <div class="feature-icon"><Icon name="people" /></div>
          <h3>Java &amp; Eaglercraft</h3>
          <p>Cracked Java and browser play. No premium account needed.</p>
          <a class="card-bottom" href="#join">Connection details <Icon name="arrow" /></a>
        </article>
      </div>
    </section>

    <section class="gallery-section page-width" aria-labelledby="gallery-heading">
      <div class="section-heading gallery-section-heading">
        <h2 id="gallery-heading">Gallery</h2>
        <a class="text-link" href="/gallery.html">View all {gallery.length} photos <Icon name="arrow" /></a>
      </div>
      <div class="gallery-grid gallery-preview">
        {homePhotos.map((photo) => (
          <GalleryCard photo={photo} categoryName={categoryName(photo.category)} />
        ))}
      </div>
    </section>

    <section class="faq-section page-width" aria-labelledby="faq-heading">
      <div>
        <h2 id="faq-heading">How to join</h2>
        <a class="text-link" href="https://discord.gg/nihilium" target="_blank" rel="noopener noreferrer">Ask us on Discord <Icon name="external" /></a>
      </div>
      <div class="faq-list">
        <details>
          <summary>How do I join on Java Edition?<span>+</span></summary>
          <p>Open Minecraft Java Edition, choose Multiplayer → Add Server, and enter <button class="inline-copy" data-copy="nihilium.org">nihilium.org <Icon name="copy" /></button> as the server address. Save it, select Nihilium, and click Join Server. Follow the in-game instructions to register or sign in. Cracked launchers are supported, so no premium account is required.</p>
        </details>
        <details>
          <summary>Can I play in my browser?<span>+</span></summary>
          <p>Yes. Open your Eaglercraft client, add <button class="inline-copy" data-copy="wss://play.nihilium.org">wss://play.nihilium.org <Icon name="copy" /></button> as the server address, and join. No Java installation is needed.</p>
        </details>
        <details>
          <summary>Can I play on Bedrock Edition?<span>+</span></summary>
          <p>Bedrock support is temporarily unavailable. Join our <a href="https://discord.gg/nihilium" target="_blank" rel="noopener noreferrer">Discord</a> for updates on when it returns.</p>
        </details>
        <details>
          <summary>What does anarchy mean here?<span>+</span></summary>
          <p>You choose how to play, and you are responsible for your actions. Deliberately lagging the server, exploiting vulnerabilities, or interfering with its operation can lead to restrictions. Read the <a href="/terms.html">Terms of Service</a> for the details.</p>
        </details>
      </div>
    </section>
  </main>
</BaseLayout>
